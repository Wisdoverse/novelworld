{
  "name": "novel-world-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "audit:dependencies": "pnpm audit --prod --audit-level high",
    "lint:fsd": "node scripts/check-fsd.mjs --self-test",
    "test:e2e:a11y": "playwright test",
    "desktop": "tauri"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.2.0",
    "@tanstack/react-query": "^5.104.1",
    "axios": "^1.20.0",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "2.12.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
