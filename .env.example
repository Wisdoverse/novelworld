# ═══════════════════════════════════════════════════════════════════════════
# NovelWorld Environment Variables
# The launchers copy this file and guide required L0 database setup. Automation
# may preseed the same values before a non-interactive launch.
# ═══════════════════════════════════════════════════════════════════════════

# ─── PostgreSQL 18 ─────────────────────────────────────────────────────────
# Written last by the launcher after the required L0 database values validate.
BOOTSTRAP_L0_COMPLETE=false
POSTGRES_USER=novel
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=novel_world

# ─── Redis ─────────────────────────────────────────────────────────────────
CACHE_MODE=postgres
# Set only when CACHE_MODE=redis; start/release tooling validates it and enables
# the Redis Compose profile atomically.
REDIS_PASSWORD=

# ─── JWT ───────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_random_32_char_string
RUNTIME_CONFIG_KEY=change_me_to_a_random_64_char_hex_string
INTERNAL_SERVICE_TOKEN=change_me_to_a_random_internal_service_token
AUTH_ACCESS_TOKEN_EXPIRY=3600
AUTH_REFRESH_TOKEN_EXPIRY=604800

# ─── LLM Providers ────────────────────────────────────────────────────────
# Leave these blank to configure DeepSeek or OpenAI later in protected Settings.
# Advanced operators can set an OpenAI-compatible endpoint here instead.

# Generic fallback (any OpenAI-compatible API)
LLM_API_KEY=
LLM_API_URL=https://api.openai.com
LLM_MODEL=gpt-4o-mini
# Current prices in USD per 1M billable tokens. Keys must match metric provider/model labels.
# Example: {"openai/gpt-4o-mini":{"cached_input":"0.075","uncached_input":"0.15","output":"0.60"}}
LLM_PRICING_USD_PER_MILLION={}
# Operator-maintained USD to CNY rate; leave empty to show tokens without a CNY estimate.
USD_CNY_RATE=
# Required by the in-app administrator usage card; available in the monitoring Compose overlay.
PROMETHEUS_URL=http://prometheus:9090

# ─── Embeddings ────────────────────────────────────────────────────────────
# Optional advanced override. Web setup currently leaves semantic search off.
# EMBEDDING_API_URL=https://api.openai.com
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small

# ─── Image Generation ─────────────────────────────────────────────────────
IMAGE_GEN_API_URL=https://api.openai.com
IMAGE_GEN_API_KEY=

# ─── S3 Object Storage ────────────────────────────────────────────────────
# Enable to retain original TXT/EPUB/PDF bytes until novel/account deletion.
S3_ENABLED=false
S3_BUCKET=novel-world-uploads
S3_REGION=us-east-1
# Leave endpoint blank for AWS S3; set it for an S3-compatible service.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Leave all three blank to use the standard AWS credential provider chain.
# Grant only s3:ListBucket on the bucket and s3:PutObject/s3:DeleteObject on source-files/*.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_SESSION_TOKEN=

# ─── Service URLs (override the compose-internal defaults) ────────────────
# Gateway and downstream services resolve each other by Docker service name
# inside compose; set these only for out-of-compose/local development.
# NOVEL_SERVICE_URL=http://novel-service:8002
# AGENT_SERVICE_URL=http://agent-service:8003

# ─── Frontend ─────────────────────────────────────────────────────────────
VITE_API_URL=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://127.0.0.1,https://your-domain.com
