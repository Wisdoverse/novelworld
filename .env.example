# ═══════════════════════════════════════════════════════════════════════════
# NovelWorld Environment Variables
# The launchers copy this file and guide required L0 database setup. Automation
# may preseed the same values before a non-interactive launch.
# ═══════════════════════════════════════════════════════════════════════════

# ─── PostgreSQL 18 ─────────────────────────────────────────────────────────
# Written last by the launcher after the required L0 database values validate.
BOOTSTRAP_L0_COMPLETE=false
POSTGRES_USER=novel
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=novel_world

# ─── Redis ─────────────────────────────────────────────────────────────────
CACHE_MODE=postgres
# Set only when CACHE_MODE=redis; start/release tooling validates it and enables
# the Redis Compose profile atomically.
REDIS_PASSWORD=

# ─── JWT ───────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_random_32_char_string
RUNTIME_CONFIG_KEY=change_me_to_a_random_64_char_hex_string
INTERNAL_SERVICE_TOKEN=change_me_to_a_random_internal_service_token
AUTH_ACCESS_TOKEN_EXPIRY=3600
AUTH_REFRESH_TOKEN_EXPIRY=604800

# JSON log filter for all Rust services. Use module directives to narrow DEBUG.
# Example: RUST_LOG=info,novel_service=debug
RUST_LOG=info

# ─── LLM Providers ────────────────────────────────────────────────────────
# Leave these blank to configure a provider later in protected Settings.
# See docs/LLM_PROVIDERS.md for CN/international API and Coding/Token Plan presets.
# Advanced operators can set an OpenAI-compatible endpoint here instead.

# Generic fallback (any OpenAI-compatible API)
# Use a root URL or full API base (e.g. https://api.minimax.cn/v1).
LLM_API_KEY=
LLM_API_URL=https://api.openai.com
LLM_MODEL=gpt-4o-mini
# Isolated reviewed Diagnostics only; leave both empty for ordinary deployments.
# Use unquoted canonical KEY=value lines. ID is an exact lowercase RFC UUIDv4.
# LIMITS is one strict JSON object with profile, max_attempts, max_tokens,
# max_cost_micro_cny, expires_at (fixed UTC seconds). No funded defaults.
# Only supported cold release adoption provisions; restart never creates/refills.
# See docs/adr/0004-durable-diagnostic-budget.md for the contract and evidence limits.
LLM_DIAGNOSTIC_BUDGET_ID=
LLM_DIAGNOSTIC_BUDGET_LIMITS=
LLM_DIAGNOSTIC_PROFILE=vision-journey-diagnostic-v1
# Optional operator overrides of the bundled official snapshot, in USD per 1M tokens.
# Keys must match exact metric provider/model labels. Coding/Token Plans cannot use token rates.
# Example: {"openai/gpt-4o-mini":{"cached_input":"0.075","uncached_input":"0.15","output":"0.60"}}
LLM_PRICING_USD_PER_MILLION={}
# Optional CNY overrides, same schema. A key in both currencies is a startup error.
LLM_PRICING_CNY_PER_MILLION={}
# Optional operator-maintained FX for legacy point estimates; native CNY/USD needs no FX.
# See docs/LLM_PRICING.md for snapshot dates, ranges, subscription quotes and limitations.
USD_CNY_RATE=
# Required by the in-app administrator usage card; available in the monitoring Compose overlay.
PROMETHEUS_URL=http://prometheus:9090

# ─── Embeddings ────────────────────────────────────────────────────────────
# Optional OpenAI-compatible local or external endpoint. Provider, URL, and
# model are required together; the key is optional for an isolated local
# endpoint. External models must return 1,536 finite values. The exact local
# model returns 1,024 values; Agent zero-pads them to the 1,536-dimension store.
# Start it without a host port: docker compose --profile local-embedding up -d embedding
# EMBEDDING_PROVIDER=local-tei
# EMBEDDING_API_URL=http://embedding:80
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# For an external endpoint, set its provider identity, HTTPS base URL, optional
# key, and exact 1,536-dimension served model instead; do not start the profile.

# ─── Image Generation ─────────────────────────────────────────────────────
IMAGE_GEN_API_URL=https://api.openai.com
IMAGE_GEN_API_KEY=

# ─── S3 Object Storage ────────────────────────────────────────────────────
# Enable to retain original TXT/EPUB/PDF bytes until novel/account deletion.
S3_ENABLED=false
S3_BUCKET=novel-world-uploads
S3_REGION=us-east-1
# Leave endpoint blank for AWS S3; set it for an S3-compatible service.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Leave all three blank to use the standard AWS credential provider chain.
# Grant s3:ListBucket on the bucket (HeadBucket readiness; no prefix condition).
# Grant s3:GetObject/s3:PutObject/s3:DeleteObject on source-files/* only.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_SESSION_TOKEN=

# ─── Service URLs (override the compose-internal defaults) ────────────────
# Gateway and downstream services resolve each other by Docker service name
# inside compose; set these only for out-of-compose/local development.
# USER_SERVICE_URL=http://127.0.0.1:8001
# NOVEL_SERVICE_URL=http://novel-service:8002
# AGENT_SERVICE_URL=http://agent-service:8003

# Optional Laya (Jev) action hints and advanced D20 adjudication. Adjudication
# is used only in advanced mode; set URL and key together. Narrative must reach
# this URL from its own container; 127.0.0.1 refers to that container.
LAYA_API_URL=
LAYA_API_KEY=

# ─── Frontend ─────────────────────────────────────────────────────────────
VITE_API_URL=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://127.0.0.1,https://your-domain.com
